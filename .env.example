# Django Core
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=acadbot-demo.onrender.com,yourdomain.com

# Database (Render provides this automatically via DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS & CSRF (replace with your actual frontend domain)
CORS_ALLOWED_ORIGINS=https://your-frontend.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.com

# Email (configure for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Optional: Sentry error tracking
SENTRY_DSN=